# Prerender Environment Variables Configuration
# Copy this file to .env and adjust values as needed

# Query parameters stripped from the URL before it becomes a lock key, a cache
# key and a render, comma separated
# Unset: a built-in list of tracking parameters (utm_*, fbclid, gclid, msclkid,
# ttclid, igshid, mc_cid, ...). Empty: strip nothing
# STRIP_QUERY_PARAMS=utm_source,utm_medium,fbclid,gclid

# Hostnames this service is allowed to render, comma separated
# Unset (default): renders ANY url it is given, which lets anything that can
# reach port 3000 read internal HTTP services through it. Set this, and keep
# the port bound to localhost or to your front end's network.
# ALLOWED_DOMAINS=example.com,www.example.com

# Redis connection URL
REDIS_URL=redis://valkey:6379

# Gzip cache entries before storing them
# Default: on. Set to 0/false/off/no to store plain JSON
# Entries written before compression existed stay readable either way: the read
# path detects gzip by its magic bytes
# PAGE_COMPRESS=1

# Cache expiration time in seconds
# Default: 604800 (7 days)
# Set to 0 for no expiration
PAGE_TTL=604800

# Maximum number of concurrent rendering processes (different URLs)
# Default: 10
# Increase if you have more CPU/memory resources
# Decrease if running on limited resources
MAX_CONCURRENT_RENDERS=10

# Lock timeout in seconds
# Default: 30
# How long to hold the lock for preventing duplicate renders of the same URL
# Should be longer than expected page load time
LOCK_TTL=30

# How long a duplicate request waits for an in-flight render of the same URL
# before giving up with 429 (milliseconds)
# Default: 8000
# Deliberately far below LOCK_TTL: if the cache stops being written, waiting out
# the whole lock just parks every duplicate request for nothing
MAX_WAIT_MS=8000

# Hosts Chrome must not reach, comma separated
# A page counts as rendered once nothing has been in flight for
# WAIT_AFTER_LAST_REQUEST. Chat widgets, video embeds and payment iframes never
# let that happen, so one of them on the page makes every render burn the whole
# PAGE_LOAD_TIMEOUT - and a blocking script that hangs can stop the page's own
# JavaScript running at all. Listed hosts resolve to 127.0.0.1 inside Chrome
# only, so their connections are refused immediately.
# Find the culprits with LOG_REQUESTS=true: a request logged with "+" and never
# with "-" is one of them.
# BLOCK_HOSTS=www.youtube.com,client-chat.example.com,pay.google.com

# Disable image loading for faster rendering
# Default: false
# Set to 'true' to skip loading images (2-5x faster)
# Recommended for SEO/crawler use cases where images are not needed
DISABLE_IMAGES=false
